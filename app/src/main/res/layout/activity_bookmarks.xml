<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/SailerToolbar"
        app:subtitle="@string/bookmarks_subtitle"
        app:title="@string/menu_bookmarks" />

    <TextView
        android:id="@+id/noPinHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_hint_banner"
        android:drawableStart="@drawable/ic_lock"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:text="@string/bookmarks_no_pin"
        android:textColor="@color/on_accent_container"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/stroke"
            android:dividerHeight="1dp" />

        <LinearLayout
            android:id="@+id/empty"
            style="@style/SailerEmptyState">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@null"
                android:padding="24dp"
                android:src="@drawable/ic_bookmarks"
                app:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/bookmarks_empty_title"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/bookmarks_empty"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
