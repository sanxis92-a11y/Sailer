<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationIcon="@drawable/ic_back"
        app:subtitle="@string/bookmarks_subtitle"
        app:subtitleTextColor="@color/text_dim"
        app:title="@string/menu_bookmarks"
        app:titleTextColor="@color/text" />

    <TextView
        android:id="@+id/noPinHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/field"
        android:padding="12dp"
        android:text="@string/bookmarks_no_pin"
        android:textColor="@color/text"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/field"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/bookmarks_empty"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />
    </FrameLayout>
</LinearLayout>
