<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_lock"
        android:tint="@color/accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/lock_title"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/pinField"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:hint="@string/lock_hint"
        android:imeOptions="actionDone|flagNoPersonalizedLearning"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:maxLength="12"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFFF6B6B"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/unlockButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/lock_unlock" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/biometricButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/lock_use_biometric" />
</LinearLayout>
