<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingEnd="40dp">

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_icon_circle">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock"
            app:tint="@color/accent" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/lock_title"
        android:textColor="@color/text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/lock_subtitle"
        android:textColor="@color/text_dim"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/pinField"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_address"
        android:gravity="center"
        android:hint="@string/lock_hint"
        android:imeOptions="actionDone|flagNoPersonalizedLearning"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:letterSpacing="0.3"
        android:maxLength="12"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/danger"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/unlockButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/lock_unlock" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/biometricButton"
        style="@style/Widget.Material3.Button.TextButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/lock_use_biometric"
        app:icon="@drawable/ic_key" />
</LinearLayout>
