    <!-- Settings -->
    <string name="settings_section_privacy">Privacy</string>
    <string name="settings_adblock">Block ads, trackers and pop-ups</string>
    <string name="settings_adblock_help">Uses a list of more than 220,000 advertising and tracking domains.</string>
    <string name="settings_doh">Encrypted DNS (pages and downloads)</string>
    <string name="settings_doh_help">Pages and downloads look up addresses over an encrypted connection (Cloudflare 1.1.1.1), so your carrier can\'t see which sites you visit.</string>
    <string name="settings_private_dns">Encrypted DNS for the whole phone</string>
    <string name="settings_private_dns_help">To encrypt DNS for every app on your phone:\n\n1. Open Settings → Network &amp; internet (or Connections) → Private DNS.\n2. Choose “Private DNS provider hostname”.\n3. Type: dns.adguard-dns.com (encrypts and also blocks ads) or one.one.one.one\n4. Save.</string>
    <string name="settings_open_settings">Open settings</string>
    <string name="settings_section_lock">Lock</string>
    <string name="settings_disguise">Disguise as “Calculator”</string>
    <string name="settings_disguise_help">The icon and name become those of a calculator that really works. To open Sailer, type your PIN in the calculator and press “=”. Requires a PIN.</string>
    <string name="settings_disguise_how">Done. From now on the app opens as a normal calculator.\n\nTo get in: type your PIN and press “=”.\nWith fingerprint on: press and hold “=”.\n\nThe icon may take a few seconds to change, and you may need to add it to your home screen again.</string>
