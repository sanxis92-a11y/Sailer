<?xml version="1.0" encoding="utf-8"?>
<!-- Prohíbe cualquier conexión sin cifrar (http://) a nivel de sistema -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
